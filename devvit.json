{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "snoo-clues",
  "description": "A daily subreddit guessing game where Sleuths analyze evidence to identify the hidden community.",
  "version": "0.1.0",
  "author": "asifdotpy",
  "license": "BSD-3-Clause",
  "categories": [
    "games",
    "entertainment"
  ],
  "marketingAssets": {
    "icon": "assets/logo_premium.png"
  },
  "media": {
    "dir": "assets"
  },
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "index.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Create a new post",
        "description": "snoo-clues",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/on-app-install"
  },
  "dev": {
    "subreddit": "snoo_clues_dev"
  }
}